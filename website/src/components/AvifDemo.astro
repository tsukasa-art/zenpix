---
// AvifDemo.astro — ブラウザ内 AVIF 変換デモ（zenpix-wasm vs Canvas API）
interface Props { lang?: 'ja' | 'en' }
const { lang = 'ja' } = Astro.props;

const t = lang === 'en' ? {
  ariaLabel:       'Select image',
  uploadText:      'Drop or click to select',
  uploadHint:      'JPEG / PNG / WebP · max 2MP',
  speedStd:        'Standard (speed=6)',
  speedFast:       'Fast (speed=10)',
  convertBtn:      'Convert',
  converting:      'Converting…',
  download:        'Download (.avif)',
  previewAlt:      'AVIF result',
  wasmNote:        'In-browser only. No data is sent to a server.',
  clickChange:     'Click to change',
  encodeFail:      'Encode failed',
  errorPrefix:     'Error: ',
  statsBefore:     'Before',
  statsAfter:      'After',
  statsRatio:      'Reduced',
  statsTime:       'Time',
  labelZenpix:     'zenpix-wasm',
  labelCanvas:     'Browser Canvas API',
  chromaZenpix:    'YUV 4:4:4 — full color',
  chromaCanvas:    'YUV 4:2:0 — color subsampled',
  notSupported:    'AVIF not supported in this browser',
  chromaNote:      'YUV 4:4:4 retains all color information. Canvas API uses YUV 4:2:0 (same as Sharp default), discarding 75% of chroma — noticeable on illustrations and vivid gradients.',
} : {
  ariaLabel:       '画像を選択',
  uploadText:      '画像をドロップまたはタップ',
  uploadHint:      'JPEG / PNG / WebP · 2MP 以下',
  speedStd:        '標準 (speed=6)',
  speedFast:       '高速 (speed=10)',
  convertBtn:      '変換',
  converting:      '変換中…',
  download:        'ダウンロード (.avif)',
  previewAlt:      'AVIF変換結果',
  wasmNote:        'ブラウザ内で完結。サーバーには送信されません。',
  clickChange:     'クリックで変更',
  encodeFail:      'エンコード失敗',
  errorPrefix:     'エラー: ',
  statsBefore:     '変換前',
  statsAfter:      '変換後',
  statsRatio:      '圧縮率',
  statsTime:       '処理時間',
  labelZenpix:     'zenpix-wasm',
  labelCanvas:     'ブラウザ Canvas API',
  chromaZenpix:    'YUV 4:4:4 — 色情報を完全保持',
  chromaCanvas:    'YUV 4:2:0 — 色差サブサンプリング',
  notSupported:    'このブラウザは Canvas AVIF に非対応',
  chromaNote:      'YUV 4:4:4 は色情報をすべて保持します。Canvas API は YUV 4:2:0（Sharp のデフォルトと同じ）を使用し、色差成分を 75% 間引くため、イラストや彩度の高いグラデーションで差が出やすいです。',
};
---

<div class="avif-demo" id="avif-demo"
  data-click-change={t.clickChange}
  data-converting={t.converting}
  data-convert-btn={t.convertBtn}
  data-encode-fail={t.encodeFail}
  data-error-prefix={t.errorPrefix}
  data-stats-before={t.statsBefore}
  data-stats-after={t.statsAfter}
  data-stats-ratio={t.statsRatio}
  data-stats-time={t.statsTime}
  data-not-supported={t.notSupported}
  data-chroma-note={t.chromaNote}
>
  <div class="upload-area" id="upload-area" role="button" tabindex="0" aria-label={t.ariaLabel}>
    <input type="file" id="file-input" accept="image/jpeg,image/png,image/webp,image/avif,image/gif" />
    <svg class="upload-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
      <polyline points="17 8 12 3 7 8"/>
      <line x1="12" y1="3" x2="12" y2="15"/>
    </svg>
    <p class="upload-text">{t.uploadText}</p>
    <p class="upload-hint">{t.uploadHint}</p>
  </div>

  <div class="controls">
    <label class="control-row">
      <span class="control-label">Quality</span>
      <input type="range" id="quality-slider" min="20" max="90" value="60" step="5" />
      <span class="control-value" id="quality-value">60</span>
    </label>
    <div class="control-row">
      <span class="control-label">Speed</span>
      <div class="radio-group">
        <label class="radio-label">
          <input type="radio" name="speed" value="6" checked />
          {t.speedStd}
        </label>
        <label class="radio-label">
          <input type="radio" name="speed" value="10" />
          {t.speedFast}
        </label>
      </div>
    </div>
  </div>

  <button class="convert-btn" id="convert-btn" disabled>{t.convertBtn}</button>

  <div class="comparison" id="comparison" hidden>
    <!-- zenpix 列（HTML順でモバイルは先に表示） -->
    <div class="col-header cmp-z-header">
      <span class="col-title">{t.labelZenpix}</span>
      <span class="col-chroma chroma-444">{t.chromaZenpix}</span>
    </div>
    <div class="stats cmp-z-stats" id="stats-zenpix"></div>
    <div class="preview-area cmp-z-preview"><img id="preview-zenpix" alt={t.previewAlt} hidden /></div>
    <a class="download-link cmp-z-dl" id="dl-zenpix" download="zenpix.avif" hidden>{t.download}</a>
    <!-- canvas 列 -->
    <div class="col-header cmp-c-header">
      <span class="col-title">{t.labelCanvas}</span>
      <span class="col-chroma chroma-420">{t.chromaCanvas}</span>
    </div>
    <div class="stats cmp-c-stats" id="stats-canvas"></div>
    <div class="preview-area cmp-c-preview"><img id="preview-canvas" alt={t.previewAlt} hidden /></div>
    <a class="download-link cmp-c-dl" id="dl-canvas" download="canvas.avif" hidden>{t.download}</a>
  </div>

  <p class="chroma-note" id="chroma-note" hidden></p>
  <p class="wasm-note">{t.wasmNote}</p>
</div>

<script is:inline type="module">
  const WASM_JS  = '/wasm/avif.simd.js';
  const WASM_BIN = '/wasm/avif.simd.wasm';
  const MAX_PIXELS = 2_000_000;

  const demo       = document.getElementById('avif-demo');
  const dropArea   = document.getElementById('upload-area');
  const fileInput  = document.getElementById('file-input');
  const qualSlider = document.getElementById('quality-slider');
  const qualValue  = document.getElementById('quality-value');
  const convertBtn = document.getElementById('convert-btn');
  const comparison = document.getElementById('comparison');
  const chromaNote = document.getElementById('chroma-note');

  const s = demo.dataset;
  let encoderReady = null;
  let selectedFile = null;

  async function getEncoder() {
    if (!encoderReady) {
      encoderReady = (async () => {
        const mod = await import(WASM_JS);
        const factory = mod.default ?? mod;
        return factory({ locateFile: (f) => f.endsWith('.wasm') ? WASM_BIN : f });
      })();
    }
    return encoderReady;
  }
  getEncoder().catch(() => {});

  async function decodeImage(file) {
    const bitmap = await createImageBitmap(file);
    let { width, height } = bitmap;
    const pixels = width * height;
    if (pixels > MAX_PIXELS) {
      const scale = Math.sqrt(MAX_PIXELS / pixels);
      width  = Math.round(width  * scale);
      height = Math.round(height * scale);
    }
    const canvas = new OffscreenCanvas(width, height);
    const ctx = canvas.getContext('2d');
    ctx.drawImage(bitmap, 0, 0, width, height);
    const { data } = ctx.getImageData(0, 0, width, height);
    return { rgba: new Uint8Array(data.buffer), width, height, canvas };
  }

  async function encodeCanvas(canvas, quality) {
    try {
      const blob = await canvas.convertToBlob({ type: 'image/avif', quality: quality / 100 });
      if (!blob || blob.size < 10) return null;
      return blob;
    } catch {
      return null;
    }
  }

  function fmtSize(bytes) {
    return bytes >= 100_000
      ? (bytes / 1_000_000).toFixed(2) + ' MB'
      : (bytes / 1_000).toFixed(1) + ' KB';
  }

  function fillResult(statsId, previewId, dlId, origSize, outSize, elapsed, url, filename) {
    const ratio = ((1 - outSize / origSize) * 100).toFixed(0);
    document.getElementById(statsId).innerHTML =
      `${s.statsAfter}: <strong>${fmtSize(outSize)}</strong>　` +
      `${s.statsRatio}: <strong>${ratio}%</strong>　` +
      `${s.statsTime}: <strong>${elapsed}ms</strong>`;
    const img = document.getElementById(previewId);
    img.src = url;
    img.removeAttribute('hidden');
    const dl = document.getElementById(dlId);
    dl.href = url;
    dl.download = filename;
    dl.removeAttribute('hidden');
  }

  function setDropState(active) { dropArea.classList.toggle('drag-over', active); }

  function onFileSelected(file) {
    if (!file || !file.type.startsWith('image/')) return;
    selectedFile = file;
    dropArea.querySelector('.upload-text').textContent = file.name;
    dropArea.querySelector('.upload-hint').textContent =
      fmtSize(file.size) + '  ·  ' + s.clickChange;
    convertBtn.disabled = false;
    comparison.hidden = true;
    chromaNote.hidden = true;
  }

  qualSlider.addEventListener('input', () => { qualValue.textContent = qualSlider.value; });
  dropArea.addEventListener('click',   (e) => { if (e.target !== fileInput) fileInput.click(); });
  dropArea.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') fileInput.click(); });
  fileInput.addEventListener('change', () => onFileSelected(fileInput.files[0]));
  dropArea.addEventListener('dragover',  (e) => { e.preventDefault(); setDropState(true); });
  dropArea.addEventListener('dragleave', ()  => setDropState(false));
  dropArea.addEventListener('drop', (e) => { e.preventDefault(); setDropState(false); onFileSelected(e.dataTransfer.files[0]); });

  convertBtn.addEventListener('click', async () => {
    if (!selectedFile) return;
    convertBtn.disabled = true;
    convertBtn.textContent = s.converting;
    comparison.hidden = true;
    chromaNote.hidden = true;

    try {
      const quality = Number(qualSlider.value);
      const speed   = Number(document.querySelector('input[name="speed"]:checked').value);
      const baseName = selectedFile.name.replace(/\.[^.]+$/, '');

      const [Module, { rgba, width, height, canvas }] = await Promise.all([
        getEncoder(),
        decodeImage(selectedFile),
      ]);

      // zenpix-wasm encode
      const t0z = performance.now();
      const inputPtr = Module._malloc(rgba.length);
      Module.HEAPU8.set(rgba, inputPtr);
      const outPtr = Module._avif_encode(inputPtr, width, height, 4, quality, speed);
      Module._free(inputPtr);
      const elapsedZ = Math.round(performance.now() - t0z);
      if (!outPtr) throw new Error(s.encodeFail);
      const outSize = Module._avif_get_out_size();
      const avifBytes = Module.HEAPU8.slice(outPtr, outPtr + outSize);
      Module._avif_free_output(outPtr);
      const urlZ = URL.createObjectURL(new Blob([avifBytes], { type: 'image/avif' }));
      fillResult('stats-zenpix', 'preview-zenpix', 'dl-zenpix',
        selectedFile.size, outSize, elapsedZ, urlZ, `${baseName}-zenpix.avif`);

      // Canvas API encode
      const t0c = performance.now();
      const canvasBlob = await encodeCanvas(canvas, quality);
      const elapsedC = Math.round(performance.now() - t0c);
      const canvasStats = document.getElementById('stats-canvas');
      const canvasPreview = document.getElementById('preview-canvas');
      const canvasDl = document.getElementById('dl-canvas');
      if (canvasBlob) {
        const urlC = URL.createObjectURL(canvasBlob);
        fillResult('stats-canvas', 'preview-canvas', 'dl-canvas',
          selectedFile.size, canvasBlob.size, elapsedC, urlC, `${baseName}-canvas.avif`);
      } else {
        canvasStats.textContent = s.notSupported;
      }

      comparison.hidden = false;
      chromaNote.textContent = s.chromaNote;
      chromaNote.hidden = false;

    } catch (e) {
      document.getElementById('stats-zenpix').textContent = s.errorPrefix + e.message;
      comparison.hidden = false;
    } finally {
      convertBtn.disabled = false;
      convertBtn.textContent = s.convertBtn;
    }
  });
</script>

<style>
  .avif-demo {
    border: 1px solid var(--sl-color-gray-5, #444);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 1.5rem 0;
    background: var(--sl-color-bg-nav, #1e1e2e);
  }

  .upload-area {
    border: 2px dashed var(--sl-color-gray-4, #555);
    border-radius: 6px;
    padding: 2rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    position: relative;
  }
  .upload-area:hover,
  .upload-area.drag-over {
    border-color: var(--sl-color-accent, #6b8cff);
    background: var(--sl-color-accent-low, rgba(107,140,255,0.08));
  }
  #file-input {
    position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
  }
  .upload-icon { width: 2rem; height: 2rem; margin-bottom: 0.75rem; color: var(--sl-color-gray-3, #888); }
  .upload-text { margin: 0; font-weight: 600; }
  .upload-hint { margin: 0.25rem 0 0; font-size: 0.85rem; color: var(--sl-color-gray-3, #888); }

  .controls {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .control-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .control-label { min-width: 5rem; font-weight: 600; font-size: 0.9rem; }
  #quality-slider { flex: 1; min-width: 120px; max-width: 220px; }
  .control-value { min-width: 2rem; font-variant-numeric: tabular-nums; }
  .radio-group { display: flex; gap: 1.25rem; align-items: center; }
  .radio-label { display: flex; align-items: center; gap: 0.35rem; font-size: 0.9rem; cursor: pointer; line-height: 1; margin: 0; }
  .radio-label input[type="radio"] { margin: 0; flex-shrink: 0; }

  .convert-btn {
    margin-top: 1.25rem;
    padding: 0.6rem 1.5rem;
    background: var(--sl-color-accent, #6b8cff);
    color: #fff;
    border: none;
    border-radius: 5px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .convert-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .convert-btn:not(:disabled):hover { opacity: 0.85; }

  /* Comparison grid */
  .comparison {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto 220px auto;
    gap: 0.6rem 1.25rem;
  }
  .comparison[hidden], .chroma-note[hidden] { display: none; }

  /* Starlight の margin-top リセット */
  .comparison > * { margin-top: 0; }

  /* デスクトップ: 明示的な列・行配置 */
  .cmp-z-header  { grid-column: 1; grid-row: 1; }
  .cmp-z-stats   { grid-column: 1; grid-row: 2; }
  .cmp-z-preview { grid-column: 1; grid-row: 3; }
  .cmp-z-dl      { grid-column: 1; grid-row: 4; }
  .cmp-c-header  { grid-column: 2; grid-row: 1; }
  .cmp-c-stats   { grid-column: 2; grid-row: 2; }
  .cmp-c-preview { grid-column: 2; grid-row: 3; }
  .cmp-c-dl      { grid-column: 2; grid-row: 4; }

  @media (max-width: 600px) {
    .upload-area { padding: 1.5rem 0.5rem; }
    .upload-hint { font-size: 0.8rem; }
  }

  /* モバイル: 1列 auto 配置（HTML順 = zenpix → canvas） */
  @media (max-width: 600px) {
    .comparison {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    .comparison > * { grid-column: 1; grid-row: auto; }
    /* canvas グループの先頭に余白 */
    .cmp-c-header { margin-top: 1.25rem; }
  }

  .col-header { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.1rem 0; }
  .col-title { font-weight: 700; font-size: 0.9rem; }
  .col-chroma { font-size: 0.75rem; }
  .chroma-444 { color: var(--sl-color-accent, #6b8cff); }
  .chroma-420 { color: var(--sl-color-gray-3, #888); }

  .stats { font-size: 0.85rem; line-height: 1.6; align-self: start; }

  .preview-area {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .preview-area img {
    max-width: 100%;
    max-height: 100%;
    border-radius: 4px;
    object-fit: contain;
  }

  .download-link {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--sl-color-accent, #6b8cff);
    border-radius: 5px;
    font-size: 0.8rem;
    color: var(--sl-color-accent, #6b8cff);
    text-decoration: none;
    align-self: start;
    justify-self: center;
  }
  .download-link:hover { background: var(--sl-color-accent-low, rgba(107,140,255,0.1)); }

  .chroma-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3, #888);
    line-height: 1.5;
  }

  .wasm-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3, #888);
  }
</style>
