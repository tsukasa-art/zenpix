---
// AvifDemo.astro — ブラウザ内 AVIF 変換デモ（zenpix-wasm）
interface Props { lang?: 'ja' | 'en' }
const { lang = 'ja' } = Astro.props;

const t = lang === 'en' ? {
  ariaLabel:    'Select image',
  uploadText:   'Drop image or click to select',
  uploadHint:   'JPEG / PNG / WebP · up to 2MP (e.g. 1920×1080)',
  speedStd:     'Standard (speed=6)',
  speedFast:    'Fast (speed=10)',
  convertBtn:   'Convert',
  converting:   'Converting…',
  download:     'Download (.avif)',
  previewAlt:   'AVIF conversion result',
  wasmNote:     'Conversion runs entirely in your browser (zenpix-wasm). No image is sent to a server.',
  clickChange:  'Click to change',
  encodeFail:   'Encode failed',
  errorPrefix:  'Error: ',
  statsBefore:  'Before',
  statsAfter:   'After',
  statsRatio:   'Reduced',
  statsTime:    'Time',
} : {
  ariaLabel:    '画像を選択',
  uploadText:   '画像をドロップ、またはクリックして選択',
  uploadHint:   'JPEG / PNG / WebP · 2MP まで（例: 1920×1080）',
  speedStd:     '標準 (speed=6)',
  speedFast:    '高速 (speed=10)',
  convertBtn:   '変換',
  converting:   '変換中…',
  download:     'ダウンロード (.avif)',
  previewAlt:   'AVIF変換結果プレビュー',
  wasmNote:     '変換はブラウザ内（zenpix-wasm）で実行されます。画像はサーバーに送信されません。',
  clickChange:  'クリックで変更',
  encodeFail:   'エンコード失敗',
  errorPrefix:  'エラー: ',
  statsBefore:  '変換前',
  statsAfter:   '変換後',
  statsRatio:   '圧縮率',
  statsTime:    '処理時間',
};
---

<div class="avif-demo" id="avif-demo"
  data-click-change={t.clickChange}
  data-converting={t.converting}
  data-convert-btn={t.convertBtn}
  data-encode-fail={t.encodeFail}
  data-error-prefix={t.errorPrefix}
  data-stats-before={t.statsBefore}
  data-stats-after={t.statsAfter}
  data-stats-ratio={t.statsRatio}
  data-stats-time={t.statsTime}
>
  <div class="upload-area" id="upload-area" role="button" tabindex="0" aria-label={t.ariaLabel}>
    <input type="file" id="file-input" accept="image/jpeg,image/png,image/webp,image/avif,image/gif" />
    <svg class="upload-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
      <polyline points="17 8 12 3 7 8"/>
      <line x1="12" y1="3" x2="12" y2="15"/>
    </svg>
    <p class="upload-text">{t.uploadText}</p>
    <p class="upload-hint">{t.uploadHint}</p>
  </div>

  <div class="controls" id="controls">
    <label class="control-row">
      <span class="control-label">Quality</span>
      <input type="range" id="quality-slider" min="20" max="90" value="60" step="5" />
      <span class="control-value" id="quality-value">60</span>
    </label>
    <div class="control-row">
      <span class="control-label">Speed</span>
      <div class="radio-group">
        <label class="radio-label">
          <input type="radio" name="speed" value="6" checked />
          {t.speedStd}
        </label>
        <label class="radio-label">
          <input type="radio" name="speed" value="10" />
          {t.speedFast}
        </label>
      </div>
    </div>
  </div>

  <button class="convert-btn" id="convert-btn" disabled>{t.convertBtn}</button>

  <div class="result" id="result" hidden>
    <div class="stats" id="stats"></div>
    <div class="preview-area">
      <img id="preview" alt={t.previewAlt} />
    </div>
    <a class="download-link" id="download-link" download="output.avif">{t.download}</a>
  </div>

  <p class="wasm-note">{t.wasmNote}</p>
</div>

<script is:inline type="module">
  const WASM_JS  = '/wasm/avif.simd.js';
  const WASM_BIN = '/wasm/avif.simd.wasm';
  const MAX_PIXELS = 2_000_000;

  const demo       = document.getElementById('avif-demo');
  const dropArea   = document.getElementById('upload-area');
  const fileInput  = document.getElementById('file-input');
  const qualSlider = document.getElementById('quality-slider');
  const qualValue  = document.getElementById('quality-value');
  const convertBtn = document.getElementById('convert-btn');
  const resultEl   = document.getElementById('result');
  const statsEl    = document.getElementById('stats');
  const previewEl  = document.getElementById('preview');
  const downloadEl = document.getElementById('download-link');

  const s = demo.dataset; // i18n strings from data-* attributes

  let encoderReady = null;
  let selectedFile = null;

  async function getEncoder() {
    if (!encoderReady) {
      encoderReady = (async () => {
        const mod = await import(WASM_JS);
        const factory = mod.default ?? mod;
        return factory({ locateFile: (f) => f.endsWith('.wasm') ? WASM_BIN : f });
      })();
    }
    return encoderReady;
  }

  getEncoder().catch(() => {});

  async function imageFileToRgba(file) {
    const bitmap = await createImageBitmap(file);
    let { width, height } = bitmap;
    const pixels = width * height;
    if (pixels > MAX_PIXELS) {
      const scale = Math.sqrt(MAX_PIXELS / pixels);
      width  = Math.round(width  * scale);
      height = Math.round(height * scale);
    }
    const canvas = new OffscreenCanvas(width, height);
    const ctx = canvas.getContext('2d');
    ctx.drawImage(bitmap, 0, 0, width, height);
    const { data } = ctx.getImageData(0, 0, width, height);
    return { rgba: new Uint8Array(data.buffer), width, height };
  }

  function fmtSize(bytes) {
    return bytes >= 100_000
      ? (bytes / 1_000_000).toFixed(2) + ' MB'
      : (bytes / 1_000).toFixed(1) + ' KB';
  }

  function setDropState(active) {
    dropArea.classList.toggle('drag-over', active);
  }

  function onFileSelected(file) {
    if (!file || !file.type.startsWith('image/')) return;
    selectedFile = file;
    dropArea.querySelector('.upload-text').textContent = file.name;
    dropArea.querySelector('.upload-hint').textContent = fmtSize(file.size) + '  ·  ' + s.clickChange;
    convertBtn.disabled = false;
    resultEl.hidden = true;
  }

  qualSlider.addEventListener('input', () => { qualValue.textContent = qualSlider.value; });

  dropArea.addEventListener('click',   (e) => { if (e.target !== fileInput) fileInput.click(); });
  dropArea.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') fileInput.click(); });
  fileInput.addEventListener('change', () => onFileSelected(fileInput.files[0]));
  dropArea.addEventListener('dragover',  (e) => { e.preventDefault(); setDropState(true); });
  dropArea.addEventListener('dragleave', ()  => setDropState(false));
  dropArea.addEventListener('drop', (e) => { e.preventDefault(); setDropState(false); onFileSelected(e.dataTransfer.files[0]); });

  convertBtn.addEventListener('click', async () => {
    if (!selectedFile) return;
    convertBtn.disabled = true;
    convertBtn.textContent = s.converting;
    statsEl.textContent = '';
    resultEl.hidden = true;

    try {
      const quality = Number(qualSlider.value);
      const speed   = Number(document.querySelector('input[name="speed"]:checked').value);

      const [Module, { rgba, width, height }] = await Promise.all([
        getEncoder(),
        imageFileToRgba(selectedFile),
      ]);

      const t0 = performance.now();
      const inputPtr = Module._malloc(rgba.length);
      Module.HEAPU8.set(rgba, inputPtr);
      const outPtr = Module._avif_encode(inputPtr, width, height, 4, quality, speed);
      Module._free(inputPtr);
      const elapsed = Math.round(performance.now() - t0);

      if (!outPtr) throw new Error(s.encodeFail);

      const outSize = Module._avif_get_out_size();
      const avifBytes = Module.HEAPU8.slice(outPtr, outPtr + outSize);
      Module._avif_free_output(outPtr);

      const blob = new Blob([avifBytes], { type: 'image/avif' });
      const url  = URL.createObjectURL(blob);
      const ratio = ((1 - outSize / selectedFile.size) * 100).toFixed(0);
      const dims  = ` (${width}×${height})`;

      statsEl.innerHTML =
        `${s.statsBefore}: <strong>${fmtSize(selectedFile.size)}</strong>${dims}　` +
        `→　${s.statsAfter}: <strong>${fmtSize(outSize)}</strong>　` +
        `${s.statsRatio}: <strong>${ratio}%</strong>　` +
        `${s.statsTime}: <strong>${elapsed}ms</strong>`;

      previewEl.src = url;
      downloadEl.href = url;
      downloadEl.download = selectedFile.name.replace(/\.[^.]+$/, '.avif');
      resultEl.hidden = false;
    } catch (e) {
      statsEl.textContent = s.errorPrefix + e.message;
      resultEl.hidden = false;
    } finally {
      convertBtn.disabled = false;
      convertBtn.textContent = s.convertBtn;
    }
  });
</script>

<style>
  .avif-demo {
    border: 1px solid var(--sl-color-gray-5, #444);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 1.5rem 0;
    background: var(--sl-color-bg-nav, #1e1e2e);
  }

  .upload-area {
    border: 2px dashed var(--sl-color-gray-4, #555);
    border-radius: 6px;
    padding: 2rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    position: relative;
  }
  .upload-area:hover,
  .upload-area.drag-over {
    border-color: var(--sl-color-accent, #6b8cff);
    background: var(--sl-color-accent-low, rgba(107,140,255,0.08));
  }

  #file-input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }

  .upload-icon { width: 2rem; height: 2rem; margin-bottom: 0.75rem; color: var(--sl-color-gray-3, #888); }
  .upload-text { margin: 0; font-weight: 600; }
  .upload-hint { margin: 0.25rem 0 0; font-size: 0.85rem; color: var(--sl-color-gray-3, #888); }

  .controls {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .control-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .control-label {
    min-width: 5rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  #quality-slider { flex: 1; min-width: 120px; max-width: 220px; }
  .control-value  { min-width: 2rem; font-variant-numeric: tabular-nums; }

  .radio-group { display: flex; gap: 1.25rem; align-items: center; }
  .radio-label { display: flex; align-items: center; gap: 0.35rem; font-size: 0.9rem; cursor: pointer; line-height: 1; margin: 0; }
  .radio-label input[type="radio"] { margin: 0; flex-shrink: 0; }

  .convert-btn {
    margin-top: 1.25rem;
    padding: 0.6rem 1.5rem;
    background: var(--sl-color-accent, #6b8cff);
    color: #fff;
    border: none;
    border-radius: 5px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .convert-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .convert-btn:not(:disabled):hover { opacity: 0.85; }

  .result { margin-top: 1.25rem; }

  .stats {
    padding: 0.75rem;
    background: var(--sl-color-bg, #13131a);
    border-radius: 5px;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .preview-area { margin-top: 1rem; text-align: center; }
  #preview {
    max-width: 100%;
    max-height: 320px;
    border-radius: 4px;
    object-fit: contain;
  }

  .download-link {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.45rem 1.1rem;
    border: 1px solid var(--sl-color-accent, #6b8cff);
    border-radius: 5px;
    font-size: 0.85rem;
    color: var(--sl-color-accent, #6b8cff);
    text-decoration: none;
  }
  .download-link:hover { background: var(--sl-color-accent-low, rgba(107,140,255,0.1)); }

  .wasm-note {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3, #888);
  }
</style>
