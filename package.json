{
  "name": "zenpix",
  "version": "1.0.3",
  "description": "Native C image processing for Node.js, Bun, and Deno via a TypeScript API and CLI.",
  "type": "module",
  "main": "js/dist/index.js",
  "types": "js/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./js/dist/index.d.ts",
      "import": "./js/dist/index.js"
    },
    "./deno": "./js/dist/index.deno.js"
  },
  "bin": {
    "zenpix": "js/dist/cli.js"
  },
  "files": [
    "js/dist",
    "README.md",
    "README.en.md",
    "README.ja.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && esbuild js/src/index.deno.ts --bundle=false --platform=neutral --format=esm --outfile=js/dist/index.deno.js && node scripts/add-shebang.mjs",
    "prepack": "npm run build",
    "wasm": "bash scripts/build-wasm.sh",
    "wasm:simd": "bash scripts/build-wasm.sh --simd",
    "wasm:all": "bash scripts/build-wasm.sh && bash scripts/build-wasm.sh --simd",
    "bench": "bun bench/bench.ts",
    "bench:threads": "bun bench/bench-threads.ts"
  },
  "keywords": [
    "avif",
    "webp",
    "image",
    "resize",
    "native"
  ],
  "author": "月村つかさ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsukasa-art/zenpix.git"
  },
  "optionalDependencies": {
    "zenpix-darwin-arm64": "1.0.3",
    "zenpix-darwin-x64": "1.0.3",
    "zenpix-linux-x64": "1.0.3",
    "zenpix-linux-arm64": "1.0.3",
    "zenpix-win32-x64": "1.0.3"
  },
  "dependencies": {
    "koffi": "^2.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.34.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "koffi"]
  }
}
