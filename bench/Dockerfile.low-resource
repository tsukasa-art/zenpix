FROM oven/bun:1.3.13-debian

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential cmake ninja-build nodejs pkg-config \
       libavif-dev libjpeg62-turbo-dev libpng-dev libwebp-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
COPY scripts ./scripts
COPY js ./js
RUN bun install --frozen-lockfile

COPY CMakeLists.txt ./
COPY include ./include
COPY src ./src
COPY vendor/stb ./vendor/stb
COPY test/test_resize_simd.c ./test/test_resize_simd.c
COPY bench ./bench

RUN cmake -S . -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DZENPIX_ENABLE_SIMD=ON \
      -DZENPIX_BUILD_TESTS=OFF \
    && cmake --build build --parallel \
    && bun run build \
    && bun build bench/resource-worker.ts \
       --target=node \
       --packages=external \
       --outfile=bench/resource-worker.node.js

ENV ZENPIX_LIB=/app/build/libpict.so
ENV BENCH_FIXTURE_PATH=/fixtures/bench_landscape_light.png

ENTRYPOINT ["bun", "run", "bench/resource-monitor.ts"]
